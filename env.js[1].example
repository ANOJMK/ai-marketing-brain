/*
 * Rename this file to env.js and generate it from your server ENV.
 * Do NOT put SUPABASE_SERVICE_ROLE_KEY here.
 * SUPABASE_ANON_KEY is a public client key, but it should still be
 * injected at runtime rather than hard-coded in select-video.html.
 */
window.__ENV__ = {
    SUPABASE_URL: 'https://YOUR_PROJECT.supabase.co',
    SUPABASE_ANON_KEY: 'YOUR_SUPABASE_ANON_KEY'
};
